# Wallpaper Engine — scene (.pkg) and CEF web renderers plus the Workshop
# subscription source.
#
# GENERATED from plugin.toml.in. Edit the template, not the installed copy.
# Every plugin must ship a sibling `files.txt` with one path per line.
#
# The Lua entry advertises scene/video/web source and subscription capabilities;
# video routes to the image/video plugin's renderer purely by wallpaper type.

[plugin]
id = "@OWE_WAYWALLEN_PLUGIN_ID@"
name = "Wallpaper Engine"
version = "@OWE_PLUGIN_VERSION@"
update = "@OWE_WAYWALLEN_PLUGIN_UPDATE_URL@"
entry = "main.lua"
entry_version = 4

[plugin.i18n]
directory = "i18n"

[renderers.wescene-renderer]
bin = "@OWE_WESCENE_BIN@"
types = ["scene"]
priority = 100
activity = "continuous"
spawn_version = 10
extras = ["assets", "workshop_id"]

[renderers.wescene-renderer.settings]
enable_audio = { type = "bool", default = true, identity = false, label = { msgid = "Enable audio" }, group = "audio", group_label = { msgid = "Audio" }, order = 5 }
volume = { type = "u32", default = 100, min = 0, max = 100, step = 1, identity = false, label = { msgid = "Volume" }, group = "audio", group_label = { msgid = "Audio" }, order = 10 }
fps    = { type = "u32", default = 30,  min = 1, max = 240, step = 1, identity = false, label = { msgid = "Frame rate" }, group = "render", group_label = { msgid = "Rendering" }, order = 20 }
hwdec = { type = "string", default = "auto", choices = ["auto", "vaapi", "vulkan", "none"], identity = true, label = { msgid = "Hardware decoding" }, group = "decode", group_label = { msgid = "Decoding" }, order = 20 }
render_node = { type = "string", default = "", identity = true, label = { msgid = "Render node" }, group = "render", group_label = { msgid = "Rendering" }, order = 30 }
msaa   = { type = "u32", default = 1, min = 1, max = 16, step = 1, identity = true, label = { msgid = "MSAA" }, group = "render", group_label = { msgid = "Rendering" }, order = 25 }
# -1 = custom, 1 = 720p, 2 = 1080p, 3 = 1440p, 4 = 2160p. Origin is disallowed for scene.
resolution = { type = "i32", default = 2, min = -1, max = 4, step = 1, identity = true, label = { msgid = "Resolution" }, group = "render", group_label = { msgid = "Rendering" }, order = 22 }
custom_extent = { type = "u32", default = 1080, min = 1, max = 8192, step = 1, identity = true, label = { msgid = "Custom resolution" }, group = "render", group_label = { msgid = "Rendering" }, order = 23 }
@OWE_WEWEB_BLOCK@
